# Every environment variable the code reads. Each has a working default for the local
# Docker stack, so a local setup needs none of them. To override one, set it in your shell
# or in a gitignored .env.local at the repo root, which the server and db scripts load.
# Production (NODE_ENV=production) must set DATABASE_URL, SYSTEM_DATABASE_URL,
# BETTER_AUTH_URL and BETTER_AUTH_SECRET.

# The port people open. In `pnpm dev` that's Vite (default 5173, also the preview port in
# .claude/launch.json); in `pnpm start` and production it's the Hono server (default 3000).
PORT=5173

# The Hono server's port during `pnpm dev`. Vite proxies /healthz and /api to it.
SERVER_PORT=3000

# Where `pnpm start` finds the built SPA. Defaults to apps/web/dist.
# WEB_DIST_DIR=

# The app's request role, ping_app, through the pooler (PgBouncer locally).
DATABASE_URL=postgres://ping_app:ping_app@localhost:6432/ping

# ping_system, for work with no signed-in Staff member (invites, sweepers).
SYSTEM_DATABASE_URL=postgres://ping_system:ping_system@localhost:6432/ping

# The owner role, for `pnpm db:migrate` and `pnpm db:seed` only. The app never uses it.
# Locally, db:migrate also sets the passwords above for ping_app and ping_system.
MIGRATION_DATABASE_URL=postgres://ping:ping@localhost:5432/ping

# Better Auth. The URL people open, and the secret that signs sessions (set a long random
# value anywhere but local development).
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=ping-local-dev-secret-not-for-production-use

# Origins allowed to call the auth routes, comma-separated. Locally defaults to
# BETTER_AUTH_URL plus http://localhost:5173 and http://localhost:3000.
# BETTER_AUTH_TRUSTED_ORIGINS=

# Integration tests: the owner's server, and the pooler-test PgBouncer.
# TEST_DATABASE_URL=postgres://ping:ping@localhost:5432/postgres
# TEST_PGBOUNCER_URL=postgres://localhost:6433

# Not read by the code: the password of every Staff member `pnpm db:seed` loads.
# SEED_PASSWORD=ping-local-dev-password
