# Copy to .env.local for local overrides. Every variable used so far is listed here.

# Port the Hono server listens on. Vite proxies /healthz and /api to it in development.
PORT=3000

# Port the Vite dev server uses (also the preview port in .claude/launch.json).
WEB_PORT=5173

# Where the server finds the built SPA. Defaults to apps/web/dist.
# WEB_DIST_DIR=
